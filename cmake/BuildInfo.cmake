# Writes ${OUT}: the version, the git commit and the build date, so the
# program can say exactly which build it is. Run at every build (see
# src/core/CMakeLists.txt); the file is rewritten only when it changes.
# Inputs: SRC (source dir), OUT (header path), VERSION.
set(commit "")
set(branch "")
find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD WORKING_DIRECTORY ${SRC}
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --abbrev-ref HEAD WORKING_DIRECTORY ${SRC}
                    OUTPUT_VARIABLE branch OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif()
# CI checks out a detached commit: the branch comes from the environment.
if(DEFINED ENV{GITHUB_REF_NAME} AND (branch STREQUAL "" OR branch STREQUAL "HEAD"))
    set(branch "$ENV{GITHUB_REF_NAME}")
endif()
if(branch STREQUAL "HEAD")
    set(branch "")
endif()
string(TIMESTAMP date "%Y-%m-%d" UTC)
set(text "#pragma once
// Generated by cmake/BuildInfo.cmake at build time. Do not edit.
#define BZ_VERSION \"${VERSION}\"
#define BZ_COMMIT \"${commit}\"
#define BZ_BRANCH \"${branch}\"
#define BZ_BUILD_DATE \"${date}\"
")
set(old "")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if(NOT old STREQUAL text)
    file(WRITE ${OUT} "${text}")
endif()
