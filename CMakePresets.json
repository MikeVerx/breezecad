{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Debug + ASan/UBSan (crash hunting)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize=alignment",
        "CMAKE_C_FLAGS": "-O1 -fno-omit-frame-pointer -fsanitize=address,undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows (MSYS2 MinGW64) Release",
      "description": "Set OCCT_DIR to the folder that contains OpenCASCADEConfig.cmake, e.g. C:/occt/install/cmake.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OpenCASCADE_DIR": "$env{OCCT_DIR}"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows (MSYS2 MinGW64) Debug",
      "inherits": "windows-mingw",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos",
      "displayName": "macOS Release (Homebrew OCCT)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "android",
      "hidden": true,
      "description": "Core and unit tests only (no window yet). ANDROID_NDK_HOME — the NDK, BZ_ANDROID_DEPS — the prefix of scripts/android/build-deps.sh.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON",
        "CMAKE_FIND_ROOT_PATH": "$env{BZ_ANDROID_DEPS}",
        "OpenCASCADE_DIR": "$env{BZ_ANDROID_DEPS}/lib/cmake/opencascade",
        "BZ_BUILD_APP": "OFF"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64 (phones), core + tests",
      "inherits": "android",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (emulator), core + tests",
      "inherits": "android",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug",         "configurePreset": "linux-debug" },
    { "name": "linux-release",       "configurePreset": "linux-release" },
    { "name": "linux-asan",          "configurePreset": "linux-asan" },
    { "name": "windows-mingw",       "configurePreset": "windows-mingw" },
    { "name": "windows-mingw-debug", "configurePreset": "windows-mingw-debug" },
    { "name": "macos",               "configurePreset": "macos" },
    { "name": "android-arm64",       "configurePreset": "android-arm64" },
    { "name": "android-x86_64",      "configurePreset": "android-x86_64" }
  ],
  "testPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug",   "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "windows-mingw", "configurePreset": "windows-mingw", "output": { "outputOnFailure": true } },
    { "name": "macos",         "configurePreset": "macos",         "output": { "outputOnFailure": true } }
  ]
}
